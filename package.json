{
  "name": "path-normalizer",
  "version": "1.0.0",
  "type": "module",
  "description": "A flexible path normalization utility for mapping backend error paths to frontend form fields",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "clean": "rm -rf dist coverage",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.ts' '__tests__/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' '__tests__/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' '__tests__/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' '__tests__/**/*.ts'",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint && npm run test",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run validate && npm run build",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "check-size": "npm run build && npm pack --dry-run && echo '\n📊 Build Output Sizes:' && ls -lh dist/"
  },
  "keywords": [
    "path",
    "normalizer",
    "form",
    "validation",
    "react-hook-form",
    "error-mapping",
    "path-mapping",
    "typescript"
  ],
  "author": "Ivan Shyrokykh shyrokykhivan@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maguwebdev/path-normalizer.git"
  },
  "bugs": {
    "url": "https://github.com/maguwebdev/path-normalizer/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "homepage": "https://github.com/maguwebdev/path-normalizer#readme",
  "peerDependencies": {
    "lodash": "^4.17.0"
  },
  "peerDependenciesMeta": {
    "lodash": {
      "optional": false
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "lodash": "^4.17.21",
    "prettier": "^3.2.5",
    "rollup": "^4.13.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "typescript": "^5.4.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/__tests__"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/index.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
